# A separate image containing ONLY the functional test project -- it has no
# ProjectReference to src/OrderApi (see OrderApi.FunctionalTests.csproj), so
# there's nothing to build here except the tests themselves. This image is
# meant to run as an OpenShift Job against an already-deployed order-api
# Service, with ORDERAPI_BASE_URL supplied at `oc create job` time.

FROM mcr.microsoft.com/dotnet/sdk:9.0

# OpenShift Jobs (like Deployments) run under the restricted SCC with an
# arbitrary, randomly-assigned non-root UID that has no /etc/passwd entry.
# The dotnet CLI can't resolve a home directory for that UID, so its
# first-run configuration step tries to write to a fallback path it doesn't
# have permission to and fails. Pointing DOTNET_CLI_HOME at /tmp -- always
# writable regardless of UID -- avoids that entirely.
ENV DOTNET_CLI_HOME=/tmp

WORKDIR /src
COPY tests/OrderApi.FunctionalTests/ ./tests/OrderApi.FunctionalTests/

WORKDIR /src/tests/OrderApi.FunctionalTests
RUN dotnet restore
RUN dotnet build -c Release --no-restore

ENTRYPOINT ["dotnet", "test", "-c", "Release", "--no-build", "--logger", "console;verbosity=normal"]